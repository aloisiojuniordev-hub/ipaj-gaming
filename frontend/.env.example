# Copie para frontend/.env.local (nunca versionar o arquivo real).
# Variáveis VITE_ vão para o bundle JavaScript PÚBLICO: só coloque valores públicos aqui.

# Projeto Supabase da IPAJ Gaming (já definido também no netlify.toml).
VITE_SUPABASE_URL=https://lvukeuyexxewmnslucwj.supabase.co

# Chave PÚBLICA do Supabase: Connect > Framework > "sb_publishable_...".
# NUNCA use sb_secret_... nem a service_role aqui.
# Sem ela, o site funciona (catálogo, recomendações Apriori, Laboratório); só login e pedidos ficam indisponíveis.
VITE_SUPABASE_PUBLISHABLE_KEY=
