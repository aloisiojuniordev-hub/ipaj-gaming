# Copie para frontend/.env.local
# Variáveis VITE_ vão para o bundle JavaScript PÚBLICO: NUNCA coloque segredos aqui
# (nada de senha do banco, service_role key, JWT_SECRET...).

# URL pública do backend FastAPI (sem barra no final). Local: uvicorn; produção: URL do Render.
VITE_API_URL=http://localhost:8000

# URL do projeto Supabase da IPAJ Gaming. Apenas REFERÊNCIA: o frontend não fala com o
# Supabase. Catálogo, recomendações Apriori, login e pedidos passam todos pelo FastAPI,
# que é o único com acesso ao banco. Por isso não existe VITE_SUPABASE_ANON_KEY neste projeto.
VITE_SUPABASE_URL=https://lvukeuyexxewmnslucwj.supabase.co
