# Copie para backend/.env (nunca versionar o .env real).

# development | production
ENVIRONMENT=development

# Local: deixe comentado para usar SQLite (backend/ipaj_local.db).
# Supabase: Project Settings > Database > Connection string (URI, Session pooler, porta 5432).
# DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# Em ENVIRONMENT=production o backend RECUSA iniciar sem uma DATABASE_URL PostgreSQL.

# SSL da conexão PostgreSQL (padrão require; prevalece sobre o sslmode da URL).
# Produção aceita apenas require | verify-ca | verify-full. Use disable só para Postgres local.
# DATABASE_SSLMODE=require

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção: mínimo de 32 caracteres.
JWT_SECRET=troque-este-valor
JWT_EXPIRES_MINUTES=120

# Origens permitidas (separadas por vírgula). Em produção: a URL da Vercel.
CORS_ORIGINS=http://localhost:5173

# Carrega data/catalog/products.csv se a tabela products estiver vazia.
SEED_ON_STARTUP=true
