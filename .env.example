# IPAJ Gaming — visão geral das variáveis de ambiente (sem valores reais).
# Cada app tem o seu próprio exemplo:
#   backend/.env.example   -> copiar para backend/.env
#   frontend/.env.example  -> copiar para frontend/.env.local
#
# Backend (Render):
#   ENVIRONMENT=production
#   DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
#   JWT_SECRET=<valor aleatório longo>
#   CORS_ORIGINS=https://<seu-site>.netlify.app
#   CORS_ORIGIN_REGEX=https://([a-z0-9-]+--)?<seu-site>\.netlify\.app   (opcional, Deploy Previews)
#   SEED_ON_STARTUP=true
#   DATABASE_SSLMODE=require
#
# Frontend (Netlify, painel > Environment variables):
#   VITE_API_URL=https://<seu-servico>.onrender.com
